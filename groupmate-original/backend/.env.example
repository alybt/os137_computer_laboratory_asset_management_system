# Copy this file to backend/.env and edit the values for your machine.
# Every setting below is optional: with no .env the API uses SQLite and the
# built-in demo credentials.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local zero-setup default (backend/lab_assets.db):
# DATABASE_URL=sqlite:///./lab_assets.db

# PostgreSQL running inside the VirtualBox VM:
# DATABASE_URL=postgresql+psycopg://labassets:CHANGE_ME@127.0.0.1:5432/labassets

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
ENVIRONMENT=development
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-secret-change-me-in-production-0s137
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Comma-separated browser origins allowed to call the API. "*" is convenient
# while testing across WSL/Distrobox and the VM. Tighten it for production,
# for example: CORS_ORIGINS=http://localhost:5173,http://192.168.1.50:5173
CORS_ORIGINS=*

# Seed demo users/inventory automatically on first startup.
AUTO_SEED=true

# ---------------------------------------------------------------------------
# Demo accounts
# ---------------------------------------------------------------------------
# admin@labassets.edu uses ADMIN_PASSWORD; the technician and viewer accounts
# use DEMO_PASSWORD.
ADMIN_PASSWORD=admin123
DEMO_PASSWORD=labassets123
