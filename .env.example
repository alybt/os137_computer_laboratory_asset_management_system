APP_ENV=production
APP_NAME="Computer Laboratory Asset Management System"
APP_URL=http://clams.local
APP_TIMEZONE=Asia/Manila
SESSION_LIFETIME=1800
# Set the actual Ubuntu host-only IPv4 address. Localhost is deliberately rejected.
DB_HOST=192.168.56.10
DB_PORT=3306
DB_NAME=labassets
DB_USER=labassets_app
DB_PASSWORD=
DB_TIMEOUT=5
# Optional CA certificate for a TLS-enabled MySQL server.
DB_SSL_CA=
