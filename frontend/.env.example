# Copy this file to frontend/.env when the API is not on the local machine.
# No file is needed for the default single-machine setup: the app calls /api
# and the Vite dev server proxies it to http://127.0.0.1:8000.

# Full API base URL, including /api. For the VirtualBox deployment use:
# VITE_API_URL=http://192.168.1.50:8000/api
VITE_API_URL=http://localhost:8000/api

# Only used by the Vite dev-server proxy while VITE_API_URL is left at /api.
# VITE_PROXY_TARGET=http://127.0.0.1:8000
